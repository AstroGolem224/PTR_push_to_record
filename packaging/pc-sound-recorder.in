#!/usr/bin/env bash
export PYTHONPATH="@INSTALL_DIR@${PYTHONPATH:+:$PYTHONPATH}"
# LD_LIBRARY_PATH muss vor dem Prozessstart stehen: ctranslate2 sucht libcublas
# und libcudnn über den dynamischen Lader, und der liest die Variable genau
# einmal beim Start. Systemweit liegt hier libcublas.so.13, ctranslate2 braucht
# .so.12 — deshalb die Wheels aus der Diktat-venv. Fehlt der Ordner, bleibt die
# Zeile wirkungslos und die Erkennung fällt auf die CPU zurück.
for nvidia in "@INSTALL_DIR@"/venv/lib/python3.*/site-packages/nvidia; do
  [ -d "$nvidia" ] || continue
  LD_LIBRARY_PATH="$nvidia/cublas/lib:$nvidia/cudnn/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  export LD_LIBRARY_PATH
  break
done
exec python3 -m pc_sound_recorder "$@"
